{
  "name": "pinky-promise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply pinky-promise --local",
    "db:remote": "wrangler d1 migrations apply pinky-promise --remote"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "wrangler": "^4.100.0"
  }
}
